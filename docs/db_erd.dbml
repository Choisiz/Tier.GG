// Tier.GG DB ERD (초안) - dbdiagram.io용 DBML
// 기준 문서: docs/db_erd.md

Project TierGG {
  database_type: 'PostgreSQL'
  Note: 'Supabase. 원본(수집한 사실) / 집계(화면이 읽는 값) / 운영(수집 기록) 3계층'
}

// ───────────── 원본 계층 ─────────────

Table players {
  puuid text [pk]
  tier text [note: 'EMERALD, DIAMOND ...']
  division text [note: 'I ~ IV, 마스터 이상은 null']
  league_points int
  wins int
  losses int
  updated_at timestamptz [default: `now()`]

  Note: '수집 대상 플레이어. league-v4 entries'
}

Table matches {
  match_id text [pk, note: 'KR_1234567890']
  queue_id int [note: '420 = 솔로랭크']
  patch text [note: '16.20 (game_version 앞 두 자리)']
  game_version text
  duration_sec int
  started_at timestamptz
  status text [not null, default: 'pending', note: 'pending | done | failed | skipped']
  fail_count int [not null, default: 0]
  collect_run_id bigint [note: '발견한 수집 회차']
  created_at timestamptz [default: `now()`]
  collected_at timestamptz

  indexes {
    status
    patch
  }

  Note: '매치 1개 = 1줄. ID 먼저 pending으로 넣고 상세 수집 후 done'
}

Table match_participants {
  match_id text [not null]
  participant_id smallint [not null, note: '1 ~ 10']
  puuid text [not null]
  team_id smallint [note: '100 | 200']
  champion_id int [not null, note: 'Data Dragon key (266 = Aatrox)']
  team_position text [note: 'TOP | JUNGLE | MIDDLE | BOTTOM | UTILITY']
  win boolean
  summoner_spells "int[]" [note: 'summoner1Id, summoner2Id 오름차순']
  rune_primary_style int
  rune_sub_style int
  runes "int[]" [note: '6개, 선택 순서대로']
  stat_perks "int[]" [note: '3개 (공격, 유연, 방어)']
  skill_order text [note: 'timeline: QEWQQRQEQE...']
  item_build "int[]" [note: 'timeline: 완성 아이템 구매 순서']
  starter_items "int[]" [note: 'timeline: 시작 아이템']
  boots_id int [note: 'timeline: 신발']
  final_items "int[]" [note: 'item0~5, 와드 제외']

  indexes {
    (match_id, participant_id) [pk]
    (champion_id, team_position)
    puuid
  }

  Note: '매치당 10줄. match-v5 상세 + timeline에서 필요한 값만 추출'
}

Table match_bans {
  match_id text [not null]
  team_id smallint [not null]
  pick_turn smallint [not null, note: '1 ~ 10']
  champion_id int [not null, note: '밴 없음(-1)은 저장하지 않음']

  indexes {
    (match_id, team_id, pick_turn) [pk]
  }
}

// ───────────── 집계 계층 ─────────────

Table patch_summary {
  patch text [pk]
  total_matches int [not null, note: '픽률, 밴률 분모']
  aggregated_at timestamptz
}

Table champion_stats {
  patch text [not null]
  champion_id int [not null]
  position text [not null]
  games int [not null]
  wins int [not null]
  bans int [note: '챔피언 기준 (포지션 무관)']
  win_rate numeric(5,2)
  pick_rate numeric(5,2)
  ban_rate numeric(5,2)
  adjusted_win_rate numeric(5,2) [note: '표본 보정 승률']
  score numeric
  tier smallint [note: '1 ~ 5, 표본 부족 시 null']
  updated_at timestamptz [default: `now()`]

  indexes {
    (patch, champion_id, position) [pk]
    (patch, position, tier, score)
  }

  Note: '리스트 화면용. 패치 x 챔피언 x 포지션 = 1줄'
}

Table champion_builds {
  patch text [not null]
  champion_id int [not null]
  position text [not null]
  category text [not null, note: 'runes | spells | skills | core_items | starter | boots']
  build_key text [not null, note: '조합 전체를 문자열로. 예: Q>E>W, 4,12']
  build_detail jsonb [note: '화면 표시용 상세']
  games int [not null]
  wins int [not null]
  updated_at timestamptz [default: `now()`]

  indexes {
    (patch, champion_id, position, category, build_key) [pk]
  }

  Note: '상세 화면용. 조합 1개 = 1줄'
}

// ───────────── 운영 계층 ─────────────

Table collect_runs {
  id bigint [pk, increment]
  started_at timestamptz [default: `now()`]
  finished_at timestamptz
  status text [note: 'running | done | failed']
  players_count int
  matches_found int
  matches_done int
  matches_failed int
  error_message text
}

// ───────────── 관계 ─────────────
// 실제 FK
Ref: match_participants.match_id > matches.match_id [delete: cascade]
Ref: match_bans.match_id > matches.match_id [delete: cascade]
Ref: champion_stats.patch > patch_summary.patch
Ref: champion_builds.(patch, champion_id, position) > champion_stats.(patch, champion_id, position) [delete: cascade]

// 논리 관계 (FK 없음, 참고용)
Ref: match_participants.puuid > players.puuid
Ref: matches.collect_run_id > collect_runs.id
