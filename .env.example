# Tier.GG 환경 변수 예시
# 실제 값은 같은 위치의 .env 파일에 넣는다. (.env는 git에 올라가지 않는다)

# ───────── Supabase (PostgreSQL) ─────────
# Supabase 대시보드 > Connect > Session pooler 의 URI
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ───────── Riot API ─────────
# 개발용 키는 24시간마다 만료된다. https://developer.riotgames.com 에서 재발급
RIOT_API_KEY=
# 플랫폼 라우팅 (league-v4 등, 한국 서버)
RIOT_PLATFORM_URL=https://kr.api.riotgames.com
# 지역 라우팅 (match-v5 등, 아시아)
RIOT_REGION_URL=https://asia.api.riotgames.com

# ───────── 백엔드 API 서버 ─────────
# 읽기 API 포트 (비워 두면 4000)
API_PORT=
# 프론트(Next.js 서버)가 부르는 읽기 API 기본 URL. /api/v1까지 포함, 끝 / 없음 (예: http://localhost:4000/api/v1)
# frontend/next.config.ts가 이 값 하나만 읽는다. NEXT_PUBLIC_을 붙이지 않는다 (브라우저에 노출 금지)
API_BASE_URL=
