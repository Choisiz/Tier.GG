# Tier.GG 환경 변수 예시
# 실제 값은 같은 위치의 .env 파일에 넣는다. (.env는 git에 올라가지 않는다)

# ───────── Supabase (PostgreSQL) ─────────
# Supabase 대시보드 > Connect > Session pooler 의 URI
# 예: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ───────── Riot API ─────────
# 개발용 키는 24시간마다 만료된다. https://developer.riotgames.com 에서 재발급
RIOT_API_KEY=
# 플랫폼 라우팅 (league-v4 등, 한국 서버)
RIOT_PLATFORM_URL=https://kr.api.riotgames.com
# 지역 라우팅 (match-v5 등, 아시아)
RIOT_REGION_URL=https://asia.api.riotgames.com

# ───────── 백엔드 API 서버 ─────────
# 읽기 API 포트 (비워 두면 4000)
API_PORT=
# 프론트(Next.js 서버)가 부르는 읽기 API 기본 URL. /api/v1까지 포함, 끝 / 없음 (예: http://localhost:4000/api/v1)
# frontend/next.config.ts가 이 값 하나만 읽는다. NEXT_PUBLIC_을 붙이지 않는다 (브라우저에 노출 금지)
API_BASE_URL=

# ───────── AI 피드백 (Anthropic Claude, docs/ai/ai_spec.md 2단계) ─────────
# Claude API 키. 서버·CLI 전용 (브라우저에 노출 금지). 없으면 CLI --yes는 거절하고 피드백은 템플릿 문장
ANTHROPIC_API_KEY=
# 문장 생성 모델 (비워 두면 claude-opus-5-5). 7단계에서 claude-sonnet-5-5·claude-haiku-5-5와 비교
FEEDBACK_LLM_MODEL=
# low | medium | high (비워 두면 low)
FEEDBACK_LLM_EFFORT=
# [CLI 전용] 평가 사용량 장부(backend/test/eval/usage-ledger.jsonl) 누적 비용 상한 USD (비워 두면 1.00). 넘을 수 있는 호출은 하지 않는다
# API 서버는 이 값을 쓰지 않는다 (아래 FEEDBACK_API_BUDGET_USD)
FEEDBACK_BUDGET_USD=

# ───────── 게임 피드백 분석 API (POST /api/v1/matches/:matchId/feedback, back_spec 변경 05) ─────────
# 기본은 모두 꺼짐/보수적이라 아래를 비워 두면 유료 호출이 일어나지 않는다. 값은 true/false만 (그 밖이면 기능을 끈다)
# 분석 API 자체를 켬 (비워 두면 false → 503 ANALYSIS_DISABLED)
FEEDBACK_ENABLED=
# 실제 LLM(유료) 호출을 켬 (비워 두면 false → 0원 템플릿 문장, templateReason "llm_off"). 프론트 개발은 false로 한다
# ANTHROPIC_API_KEY가 있어도 이 값이 true가 아니면 Claude를 부르지 않는다
FEEDBACK_LLM_ENABLED=
# 하루(한국 시간) LLM 분석 상한 (비워 두면 20). 0이면 LLM 없이 템플릿 문장만. 캐시 적중·템플릿은 세지 않는다
FEEDBACK_DAILY_LIMIT=
# API 전용 사용량 장부(backend/logs/feedback-api-ledger.jsonl, git 제외) 누적 비용 상한 USD (비워 두면 0.25)
# 판당 최악 비용(약 $0.22)을 미리 예약하므로, 장부 합 + 최악이 상한을 넘으면 429 budget
FEEDBACK_API_BUDGET_USD=
